# === Identité images Docker Hub (obligatoire) ===
# Compte Hub qui publie les images, ex. moncompte → moncompte/pulse-api:demo
DOCKERHUB_USER=CHANGE_ME
IMAGE_TAG=demo
API_IMAGE_NAME=pulse-api
PYTHON_IMAGE_NAME=pulse-python

# === Accès web ===
HTTP_PORT=80
PUBLIC_BASE_URL=http://localhost

# MySQL exposé sur l’hôte (DBeaver) — éviter 3306 si un MySQL local existe déjà
MYSQL_HOST_PORT=3307

# === MySQL (changer les mots de passe chez le client) ===
MYSQL_ROOT_PASSWORD=pulse_demo_root_ChangeMe
MYSQL_DATABASE=backupcontent
MYSQL_USER=backup
MYSQL_PASSWORD=backup_ChangeMe

# === Compte admin créé au 1er démarrage ===
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=DemoAdmin123!
DEMO_ADMIN_NAME=Admin
DEMO_ADMIN_FAMILY_NAME=Demo
DEMO_COMPANY_NAME=Société principale
DEMO_TENANT_NAME=Tenant principal
DEMO_MODULES=core
DEMO_FORCE_RESET=false
STORE_BRAND_NAME=Pulse

# Clé JWT (≥ 32 caractères) — unique par client
JWT_KEY=ChangeMe_DemoSecretKey_AtLeast32Chars!!

# === RapidAPI (VIN + import K-Type à la demande) ===
RAPIDAPI_KEY=

# Module auto_parts requis pour scan VIN / plaque
# DEMO_MODULES=core,auto_parts

# === Optionnel ===
ERP_SYNC_ENABLED=false
# Serveur images EuroBrico (PicName → http://host:15022/fichier.jpg)
ERP_IMAGE_BASE_URL=http://eurobrico.ddns.net:15022
OPENAI_API_KEY=
USE_OPENAI=false
DOCUMENT_AI_USE_AI=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
